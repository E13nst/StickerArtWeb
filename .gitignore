# Dependencies
node_modules/

# Build output
dist/

# Local env files
.env
.env.local
.env.*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Cursor: в репозитории держим .cursor/rules/ и .cursor/commands/ (общие правила и команды).
# Не версионируем локальные планы и состояние worktree IDE:
.cursor/plans/
.cursor/worktrees.json

# Локальные дополнения к справочникам / AGENTS (остаются только на машине)
.cursor/api-reference.local.md
.cursor/*.local.md
AGENTS.local.md
docs/**/*.local.md

# Старые/рабочие markdown-отчёты в docs не добавляем автоматически.
# Общие agent-readable документы добавляй явно; базовая карта docs остаётся в git.
docs/*.md
!docs/README.md
miniapp/docs/*.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tooling cache
.eslintcache
*.tsbuildinfo

# Testing
coverage/
test-results/
test-results-prod/
**/test-results/
**/test-results/**/*
playwright-report/
playwright-report-prod/
**/playwright-report/
**/playwright-report/**/*
*.test-results.json
*.test-results.xml

# Temp
.cache/
*.local
*.bak*

